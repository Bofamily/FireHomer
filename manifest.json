{
  "manifest_version": 2,
  "name": "FireHomer",
  "version": "1.1",
  "description": "Choose your own website for every new tab.",
  "permissions": ["storage"],
  "content_security_policy": "script-src 'self'; object-src 'self'; frame-src http: https:",
  "browser_action": {
    "default_title": "Change Homepage",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "firehomer@example.com",
      "strict_min_version": "109.0",
    "data_collection_permissions": {
      "required": ["websiteContent"],
      "optional": []
    }
    }
  }
}